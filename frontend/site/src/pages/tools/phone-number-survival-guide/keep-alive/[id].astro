---
import PhoneLayout from '../../../../layouts/PhoneLayout.astro';
import { data, keepAliveModels, moneyShort, PHONE_BASE, GUIDE_BASE } from '../../../../data/phone.js';

export function getStaticPaths() {
  return keepAliveModels().map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const m = keepAliveModels().find((x) => x.id === id)!;
const base = `${PHONE_BASE}keep-alive/`;
const canonical = `${base}${m.id}/`;

const title = `${m.brandName} keep-alive rules – ${m.marketName} SIM retention – Phone Radar`;
const desc = m.hold
  ? `${m.brandName} keep-alive status: on observation hold — no clean durable retention path is currently established. Hold reason and re-open conditions.`
  : `${m.brandName} keep-alive rules (${m.marketName}): ${m.interval}-day window, act at least every ${m.safe} days, about ${moneyShort(m.perAction, m.currency)} per action and ${moneyShort(m.yearOriginal, m.currency)} per year. Steps, evidence state and a deadline calculator.`;
const pageLd = { '@context': 'https://schema.org', '@type': 'WebPage', name: `${m.brandName} keep-alive rules`, description: desc, url: canonical, dateModified: m.lastVerifiedAt !== 'unknown' ? m.lastVerifiedAt : data.checkedAt, isPartOf: { '@type': 'WebSite', name: 'Phone Radar', url: PHONE_BASE } };
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aineedhelpfromotherai.com/' },
  { '@type': 'ListItem', position: 2, name: 'Phone Radar', item: PHONE_BASE },
  { '@type': 'ListItem', position: 3, name: 'Keep-Alive Assistant', item: base },
  { '@type': 'ListItem', position: 4, name: m.brandName, item: canonical }
]};
---
<PhoneLayout title={title} desc={desc} canonical={canonical} ogType="article" jsonLd={[pageLd, crumbs]}>
<style is:global>
.ka-wrap{max-width:900px;padding-bottom:70px}
.ka-wrap h1{font-size:clamp(2rem,5vw,3.2rem);margin:.2em 0}
.ka-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0}
.ka-stats div{border:1px solid var(--line);border-radius:12px;padding:12px}
.ka-stats small{display:block;color:var(--muted);text-transform:uppercase;font-size:.66rem;font-weight:850;letter-spacing:.05em}
.ka-stats strong{display:block;margin-top:5px;font-size:1rem}
.ka-pill{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:4px 9px;font-size:.74rem;font-weight:800;margin:0 6px 6px 0}
.ka-pill.ka-stale{border-color:#d9a441;color:#9a6700}
.ka-note{font-size:.86rem;color:var(--muted)}
.ka-hold{border:1px solid #d9a441;border-radius:14px;background:#fff8e8;padding:14px 16px;margin:14px 0;color:#5b4308}
.ka-warnbox{border:1px solid #d9a441;border-radius:12px;padding:12px 14px;margin:12px 0;font-size:.88rem}
.ka-steps{margin:10px 0 18px}
.ka-steps li{margin:6px 0;font-size:.93rem}
.ka-links{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;font-size:.9rem}
@media(max-width:760px){.ka-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<main class="shell ka-wrap">
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href={GUIDE_BASE}>Phone Radar</a><span>›</span><a href={base}>Keep-Alive Assistant</a><span>›</span><span>{m.brandName}</span></nav>
<p class="eyebrow">Phone Radar · Keep-Alive Assistant</p>
<h1>{m.brandName} keep-alive rules</h1>
<div style="margin:10px 0"><span class="ka-pill">{m.stateLabel}</span><span class="ka-pill">Verified {m.lastVerifiedAt}</span>{m.stale && <span class="ka-pill ka-stale">Re-verification due</span>}</div>
{m.hold ? (
<>
<div class="ka-hold"><strong>On hold — no calculator offered.</strong><br>{m.holdReason}</div>
<p>This route stays backstage until a durable retention rule is established on current evidence. Re-open condition: a verified, lawful, reproducible keep-alive path.</p>
</>
) : (
<>
{m.continuityWarning && <div class="ka-warnbox"><strong>Continuity warning:</strong> {m.continuityWarning}</div>}
<div class="ka-stats">
<div><small>Window</small><strong>{m.interval} days</strong></div>
<div><small>Safe rhythm</small><strong>every {m.safe} days</strong></div>
<div><small>Cost per action</small><strong>{m.perAction !== null ? `~${moneyShort(m.perAction, m.currency)}` : 'n/a'}</strong></div>
<div><small>Keep cost / year</small><strong>{m.yearOriginal !== null ? moneyShort(m.yearOriginal, m.currency) : 'n/a'}</strong></div>
</div>
<p><strong>What to do:</strong> {m.action}</p>
<p class="ka-note">{m.bufferNote} Repeats needed: about {m.perYearActions}× per year.</p>
<ol class="ka-steps">{m.steps.map((s) => <li>{s}</li>)}</ol>
</>
)}
<div class="ka-links"><a href={`${base}#${m.id}`}>Open in the deadline calculator →</a><a href={`${GUIDE_BASE}route/${m.id}/`}>Full route evidence →</a></div>
</main>
</PhoneLayout>
