[Unit]
Description=aineedhelp keyword discovery radar
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aineedhelp-keyword-radar
ExecStart=/usr/bin/python3 /opt/aineedhelp-keyword-radar/radar.py --data-dir /var/lib/aineedhelp-radar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aineedhelp-radar
