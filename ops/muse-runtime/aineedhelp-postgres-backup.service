[Unit]
Description=AI Need Help PostgreSQL verified Btrfs backup
After=postgresql@16-main.service
Requires=postgresql@16-main.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/usr/bin/bash /home/hatch/workspace/aineedhelp-db-recovery/check-pgdata-mount.sh
ExecStart=/usr/bin/bash /home/hatch/workspace/aineedhelp-db-recovery/backup-postgres-btrfs.sh
