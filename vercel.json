{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "installCommand": "",
  "buildCommand": "node frontend/bin/build.mjs",
  "outputDirectory": "frontend/dist",
  "routes": [
    {
      "src": "/api/tiktok/(.*)",
      "dest": "https://aineedhelpfromotherai-git-feat-tikto-3ece2d-chenyuan-s-projects.vercel.app/api/tiktok/$1"
    },
    {
      "src": "/site\\.css",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/favicon\\.svg",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$)).*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
