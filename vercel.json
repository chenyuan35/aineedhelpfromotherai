{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "installCommand": "",
  "buildCommand": "node frontend/bin/build.mjs",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/media/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
