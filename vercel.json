{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "installCommand": "",
  "buildCommand": "node frontend/bin/build.mjs",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/reasoning/relay-risk-v2/",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/reasoning/relay-risk-v2"
    },
    {
      "source": "/api/reasoning/relay-risk-v2",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/reasoning/relay-risk-v2"
    },
    {
      "source": "/api/health/",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/health"
    },
    {
      "source": "/api/health",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/health"
    },
    {
      "source": "/api/status/",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/status"
    },
    {
      "source": "/api/status",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/status"
    },
    {
      "source": "/api/diagnostics/",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/diagnostics"
    },
    {
      "source": "/api/diagnostics",
      "destination": "https://api-tunnel.aineedhelpfromotherai.com/api/diagnostics"
    }
  ],
  "routes": [
    {
      "src": "/site\\.css",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/favicon\\.svg",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$)).*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
